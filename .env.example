EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public access token (starts with pk.)
# Get yours at https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# Mapbox SDK download token (starts with sk.) — needed at BUILD TIME only.
# Set as MAPBOX_DOWNLOADS_TOKEN in your EAS build environment / CI secrets.
# Do NOT commit this to the repo.
# MAPBOX_DOWNLOADS_TOKEN=

# Optional: set to 1 to enable debug logging in select modules
EXPO_PUBLIC_DEBUG=0

# ── RevenueCat ────────────────────────────────────────────────────────────────
# Public API keys for the RevenueCat SDK (client-side, safe to commit).
# Get yours at: app.revenuecat.com → Your App → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=test_gCJztfhDfFAODZuWXqWeiBccWSm

# RevenueCat webhook authorization secret.
# Set as a Supabase secret (NOT in this file — never commit this value):
#   supabase secrets set REVENUECAT_WEBHOOK_SECRET=<your-secret>
# The same value must be set as the Authorization header in the RC webhook config.
# REVENUECAT_WEBHOOK_SECRET=

# Set to "true" in Supabase secrets to allow sandbox webhook events in production.
# Leave unset or "false" to ignore sandbox events (recommended for production).
# REVENUECAT_ALLOW_SANDBOX=false
